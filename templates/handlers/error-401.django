{% extends "base.django" %}
{% load static %}
{% block content %}
    <div class="page-wrapper page-center">
      <div class="container-tight py-4">
        <div class="empty">
          <div class="empty-img">
              <img src="{% static 'img/401.png' %}" height="256" alt="401 Unauthorized" fill="none" viewBox="0 0 800 600">
          </div>
          <p class="empty-title">401</p>
          <p class="empty-subtitle text-secondary">You don't have permission to access this page.<br> Contact your system administrator to request access.</p>
          <div class="empty-action">
            <a href="{% url 'dashboard' %}" class="btn btn-primary btn-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-2">
                <path d="M5 12l14 0"></path>
                <path d="M5 12l6 6"></path>
                <path d="M5 12l6 -6"></path>
              </svg>Take me home
            </a>
          </div>
        </div>
      </div>
    </div>
{% endblock %}