{% load static %}
<!DOCTYPE html>
<html lang="en" data-layout="horizontal" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>QRAS - Masterbatch Philippines Inc.</title>
    <link rel="icon" href="{% static 'img/ico_primary.svg' %}" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="{% static 'img/ico_white.svg' %}" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="stylesheet" href="{% static 'css/tabler.css' %}" />
    <link rel="stylesheet" href="{% static 'css/qras.css' %}" />
    <link rel="stylesheet" href="{% static 'css/libraries/tom_select.css' %}" />
    <link rel="stylesheet" href="{% static 'css/libraries/daterangepicker.css' %}" />
    <link rel="stylesheet" href="{% static 'css/libraries/shepherd.css' %}" />
    <script src="{% static 'js/components/shared/table.js' %}"></script>
    <script src="{% static 'js/libraries/tom_select.js' %}"></script>
    <script src="{% static 'js/libraries/jquery.js' %}"></script>
    <script src="{% static 'js/libraries/moment.js' %}"></script>
    <script src="{% static 'js/libraries/daterangepicker.js' %}"></script>
  </head>

  <body class="antialiased">
    {% comment %} {% include 'components/global/sidebar.django' %} {% endcomment %}
    {% comment %} {% include 'components/global/modal.django' %}
    {% include 'components/shared/toast.django' %}
    {% include 'components/shared/toast_modal.django' %} {% endcomment %}
    {% if user.is_authenticated %}
    <main class="page">
      {% comment %} {% block content %}{% endblock %} {% endcomment %}
      <h1>Hello Test from base.django</h1>
      {% include 'components/global/footer.django' %}
    </main>
    {% endif %}
    {% include 'components/shared/scroller.django' %}
    {% comment %} <script>window.CLOCK_OFFSET_MINUTES = {{ CLOCK_OFFSET_MINUTES }};</script> {% endcomment %}
    <script src="{% static 'js/libraries/imask.js' %}"></script>
    <script src="{% static 'js/libraries/tabler.js' %}"></script>
    <script src="{% static 'js/libraries/imask_custom.js' %}"></script>
    <script src="{% static 'js/components/global/theme.js' %}"></script>
    <script src="{% static 'js/components/shared/scroller.js' %}"></script>
    <script src="{% static 'js/components/pages/input/clock.js' %}"></script>
    <script src="{% static 'js/components/pages/features/date_time.js' %}"></script>
    <script src="{% static 'static\js\components\pages\authentications\pass_eye.js' %}"></script>
    <script type="module">import Shepherd from "{% static 'js/libraries/shepherd.js' %}";window.Shepherd = Shepherd;</script>
    <script src="{% static 'js/libraries/shepherd.js' %}"></script>
    {% comment %} {% block scripts %}{% endblock %} {% endcomment %}
  </body>

</html>