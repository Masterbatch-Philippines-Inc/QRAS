{% extends 'base.django' %}
{% load static %}
{% block content %}
    {% if request.GET.pw_changed %}
    <script>alert('Your password has been changed successfully.');</script>
    {% endif %}
    <div class="page-wrapper">
      <div class="container-xl mt-5">
        <!-- ── Page Header ─────────────────────────────────────────── -->
        <div class="mb-2">
          <h2 class="mb-0">Change Password</h2>
        </div>
        <ol class="breadcrumb text-secondary mb-4" aria-label="breadcrumbs">
          <li class="breadcrumb-item active" aria-current="page">&nbsp;</li>
        </ol>
        <div class="row justify-content-center">
          <div class="col-lg-5 col-md-7">
            <div class="card">

              <div class="card-header">
                <h3 class="card-title">
                  <i class="ti ti-lock me-2"></i>Update your password
                </h3>
              </div>

              <div class="card-body">

                <!-- ── Non-field errors ────────────────────────────── -->
                {% if form.non_field_errors %}
                  <div class="alert alert-danger mb-3">
                    {% for error in form.non_field_errors %}
                      {{ error }}
                    {% endfor %}
                  </div>
                {% endif %}

                <form method="POST" id="pwForm">
                  {% csrf_token %}

                  <!-- Current Password -->
                  <div class="mb-3">
                    <label class="form-label required">Current Password</label>
                    <div class="input-group {% if form.old_password.errors %}is-invalid{% endif %}">
                      <input
                        type="password"
                        id="field_old"
                        name="{{ form.old_password.html_name }}"
                        class="form-control {% if form.old_password.errors %}is-invalid{% endif %}"
                        placeholder="Enter your current password"
                        autocomplete="current-password"
                      >
                      <button type="button" class="btn btn-outline-secondary px-2 d-inline-flex align-items-center" onclick="togglePassword('field_old', 'icon_old')" tabindex="-1">
                        <span id="icon_old"></span>
                      </button>
                    </div>
                    {% if form.old_password.errors %}
                      <div class="invalid-feedback d-block">
                        {% for error in form.old_password.errors %}{{ error }}{% endfor %}
                      </div>
                    {% endif %}
                  </div>

                  <!-- New Password -->
                  <div class="mb-3">
                    <label class="form-label required">New Password</label>
                    <div class="input-group {% if form.new_password1.errors %}is-invalid{% endif %}">
                      <input
                        type="password"
                        id="field_new1"
                        name="{{ form.new_password1.html_name }}"
                        class="form-control {% if form.new_password1.errors %}is-invalid{% endif %}"
                        placeholder="Enter new password"
                        autocomplete="new-password"
                      >
                      <button type="button" class="btn btn-outline-secondary px-2 d-inline-flex align-items-center" onclick="togglePassword('field_new1', 'icon_new1')" tabindex="-1">
                        <span id="icon_new1"></span>
                      </button>
                    </div>
                    {% if form.new_password1.errors %}
                      <div class="invalid-feedback d-block">
                        {% for error in form.new_password1.errors %}{{ error }}{% endfor %}
                      </div>
                    {% else %}
                      <div class="form-hint">
                        Minimum 8 characters. Cannot be entirely numeric or too common.
                      </div>
                    {% endif %}
                  </div>

                  <!-- Confirm New Password -->
                  <div class="mb-0">
                    <label class="form-label required">Confirm New Password</label>
                    <div class="input-group">
                      <input
                        type="password"
                        name="{{ form.new_password2.html_name }}"
                        class="form-control"
                        placeholder="Re-enter new password"
                        autocomplete="new-password"
                      >
                    </div>
                    {% if form.new_password2.errors %}
                      <div class="invalid-feedback d-block">
                        {% for error in form.new_password2.errors %}{{ error }}{% endfor %}
                      </div>
                    {% endif %}
                  </div>

                </form>

              </div>

              <div class="card-footer d-flex justify-content-between align-items-center">
                <a href="javascript:history.back()" class="btn btn-ghost-secondary">
                  Go back
                </a>
                <button type="submit" class="btn btn-primary" onclick="document.getElementById('pwForm').submit()">
                  Update Password
                </button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
{% endblock %}