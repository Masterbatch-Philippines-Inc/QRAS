{% extends 'base.django' %}
{% load static %}
{% block content %}
    <div class="page-wrapper">
      {% if dept_warning %}
      <div class="container-xl mt-4">
        <div class="alert alert-warning d-flex gap-2 align-items-center">
          Your account is not assigned to a department. Contact your administrator to get access.
        </div>
      </div>
      {% endif %}
      <div class="container-xl mt-5">
        {% if request.GET.batch_imported %}
        <div class="alert alert-success alert-dismissible mb-3" role="alert">
          <strong>{{ request.GET.batch_imported }} employee{{ request.GET.batch_imported|pluralize }}</strong> imported successfully.
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endif %}
        <div class="d-flex align-items-center justify-content-between" style="margin-bottom:.35rem;">
          <h2 class="mb-0">Employees</h2>
          <button id="emp-btn-help-tour" class="btn btn-sm btn-ghost-secondary" title="Employee Records page tour">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            &nbsp;Need Help
          </button>
        </div>
        <ol class="breadcrumb text-secondary" aria-label="breadcrumbs" style="margin: 0 0 1rem 0;">
          <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
          <li class="breadcrumb-item active" aria-current="page">Employee Records</li>
        </ol>
        <div class="row row-cards">

          <!-- TABLE COLUMN -->
          <div class="col-md-6 col-lg-8">
            <div class="card">
              <div class="card-table">
                <div class="card-header">
                  <div class="row w-full">
                    <div class="col">
                      <h3 class="card-title mb-0">Employee Records</h3>
                      <p class="text-secondary m-0">Total of {{ employees.count }} company employee{{ employees.count|pluralize }}</p>
                    </div>
                    <div class="col-md-auto col-sm-12">
                      <div class="ms-auto d-flex flex-wrap btn-list">
                        <div class="input-group input-group-flat w-auto">
                          <span class="input-group-text">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-1">
                              <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                              <path d="M21 21l-6 -6"></path>
                            </svg>
                          </span>
                          <input type="text" id="searchEmployeeInput" class="form-control" placeholder="Search by name or ID…">
                        </div>
                        <div class="col-auto">
                          <select id="statusFilter" class="form-select">
                            <option value="">All Status</option>
                            <option value="active" selected>Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="resigned">Resigned</option>
                          </select>
                        </div>
                        <a id="btnBatchAdd" href="{% url 'batch-add-employee' %}" class="btn btn-secondary btn-icon" aria-label="Button" data-bs-toggle="tooltip" data-bs-placement="top" title="By batch add of employees">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-cash-plus">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M7 15h-3a1 1 0 0 1 -1 -1v-8a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v3" />
                            <path d="M12 19h-4a1 1 0 0 1 -1 -1v-8a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v2.5" />
                            <path d="M12 14a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                            <path d="M16 19h6" />
                            <path d="M19 16v6" />
                          </svg>
                        </a>
                        {% if request.user.role.name == 'Administrator' %}
                        <button id="btnBatchDeactivate" class="btn d-none" data-bs-toggle="modal" data-bs-target="#modalBatchDeactivate">
                          <span id="batchActionLabel">Set Inactive</span> (<span id="batchSelectedCount">0</span>)
                        </button>
                        {% endif %}
                        <a id="btnAddEmployee" href="{% url 'add-employee' %}" class="btn btn-primary btn-icon" aria-label="Button" data-bs-toggle="tooltip" data-bs-placement="top" title="Add new employee">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-plus">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 5l0 14" />
                            <path d="M5 12l14 0" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div id="tableEmployeeRecords">
                  <div class="table-responsive">
                    <table class="table table-vcenter table-bordered" id="employeeTable">
                      <thead>
                        <tr>
                          <th hidden>#</th>
                          {% if request.user.role.name == 'Administrator' %}
                          <th style="width:1%;"><input type="checkbox" id="selectAllEmployees" class="form-check-input"></th>
                          {% endif %}
                          <th>Employee ID</th>
                          <th>Name</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for emp in employees %}
                          <tr class="cursor-pointer employee-row"
                              data-status="{% if emp.is_resigned %}resigned{% elif emp.is_active %}active{% else %}inactive{% endif %}"
                              {% if request.user.role.name == 'Administrator' %}data-emp-checkbox-row="1"{% endif %}
                              data-is-resigned="{% if emp.is_resigned %}1{% else %}0{% endif %}"
                              data-id="{{ emp.id }}"
                              data-employee-id="{{ emp.employee_id }}"
                              data-first-name="{{ emp.first_name }}"
                              data-middle-name="{{ emp.middle_name }}"
                              data-last-name="{{ emp.last_name }}"
                              data-suffix-name="{{ emp.suffix_name }}"
                              data-department="{{ emp.department|default:'—' }}"
                              data-department-id="{{ emp.department_id|default:'' }}"
                              data-position="{{ emp.position|default:'—' }}"
                              data-position-id="{{ emp.position_id|default:'' }}"
                              data-hire-date="{{ emp.hire_date|date:'Y-m-d'|default:'' }}"
                              data-date-regularized="{{ emp.date_regularized|date:'Y-m-d'|default:'' }}"
                              data-birth-date="{{ emp.details.birth_date|date:'Y-m-d'|default:'' }}"
                              data-contact-no="{{ emp.contact.contact_no|default:'' }}"
                              data-address1="{{ emp.contact.address_1|default:'' }}"
                              data-address2="{{ emp.contact.address_2|default:'' }}"
                              data-sos-name="{{ emp.contact.sos_contact_person|default:'' }}"
                              data-sos-no="{{ emp.contact.sos_contact_no|default:'' }}"
                              data-tin="{{ emp.gov_ids.tin_no|default:'' }}"
                              data-sss="{{ emp.gov_ids.sss_no|default:'' }}"
                              data-philhealth="{{ emp.gov_ids.philhealth_no|default:'' }}"
                              data-pagibig="{{ emp.gov_ids.pagibig_no|default:'' }}">
                            <td hidden>{{ forloop.counter }}</td>
                            {% if request.user.role.name == 'Administrator' %}
                            <td onclick="event.stopPropagation();">
                              <input type="checkbox" class="form-check-input emp-select-checkbox"
                                     value="{{ emp.id }}"
                                     data-name="{{ emp.last_name }}, {{ emp.first_name }}"
                                     data-active="{% if emp.is_active %}1{% else %}0{% endif %}"
                                     data-resigned="{% if emp.is_resigned %}1{% else %}0{% endif %}"
                                     {% if emp.is_resigned %}disabled title="Use 'Restore Employee' for resigned employees"{% endif %}>
                            </td>
                            {% endif %}
                            <td class="text-secondary">{{ emp.employee_id }}</td>
                            <td>{{ emp.last_name }}, {{ emp.first_name }}{% if emp.middle_name %} {{ emp.middle_name.0 }}.{% endif %}</td>
                            <td>
                              {% if emp.is_resigned %}
                                <span class="badge bg-red-lt">Resigned</span>
                              {% elif emp.is_active %}
                                <span class="badge bg-success-lt">Active</span>
                              {% else %}
                                <span class="badge bg-secondary-lt">Inactive</span>
                              {% endif %}
                            </td>
                          </tr>
                        {% empty %}
                          <tr>
                            <td colspan="3" class="text-center">No records found</td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                  <div class="card-footer d-flex align-items-center">
                    <div class="dropdown">
                      <a class="btn dropdown-toggle" data-bs-toggle="dropdown">
                        <span id="page-count" class="me-1">10</span>
                        <span>records</span>
                      </a>
                      <div class="dropdown-menu">
                        <a class="dropdown-item" onclick="setPageListItems(event)" data-value="10">10 records</a>
                        <a class="dropdown-item" onclick="setPageListItems(event)" data-value="20">20 records</a>
                        <a class="dropdown-item" onclick="setPageListItems(event)" data-value="50">50 records</a>
                        <a class="dropdown-item" onclick="setPageListItems(event)" data-value="100">100 records</a>
                      </div>
                    </div>
                    <ul class="pagination m-0 ms-auto" id="paginationEl"></ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- DETAIL CARD COLUMN -->
          <div class="col-md-6 col-lg-4">

            <!-- Placeholder card (shown by default) -->
            <div class="card sticky-top" style="top: 2rem;z-index: 5;" id="employeePlaceholder">
              <div class="card-body text-center">
                <div class="mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-secondary" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 7h6"></path>
                    <path d="M9 11h6"></path>
                    <path d="M9 15h4"></path>
                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                  </svg>
                </div>
                <h3 class="mb-1">Choose an employee</h3>
                <p class="text-secondary mb-4">Click a row from the table to view details.</p>
                <div class="mt-4 placeholder-glow">
                  <div class="placeholder placeholder-xs col-5"></div>
                  <div class="placeholder placeholder-xs col-4"></div>
                  <div class="placeholder placeholder-xs col-5"></div>
                  <div class="placeholder placeholder-xs col-5"></div>
                  <div class="placeholder placeholder-xs col-3"></div>
                </div>
                <div class="mt-3 placeholder-glow">
                  <a href="#" tabindex="-1" class="btn btn-secondary disabled placeholder col-5" aria-hidden="true"></a>
                  <a href="#" tabindex="-1" class="btn btn-primary disabled placeholder col-5" aria-hidden="true"></a>
                </div>
              </div>
            </div>

            <!-- Populated card (hidden until row clicked) -->
            <div class="card d-none sticky-top" id="selectedEmployee" style="top: 2rem;z-index: 5;">

              <!-- Header: avatar + name + status -->
              <div class="card-body pb-5">
                <div class="d-flex align-items-center gap-3">
                  <span class="avatar avatar-lg" id="empAvatar"></span>
                  <div class="flex-fill" style="min-width:0;">
                    <div class="fw-medium text-truncate" id="empName">—</div>
                    <div class="text-secondary small" id="empId">—</div>
                    <div class="mt-1" id="empStatusBadge">
                      <span class="badge bg-success-lt">Active</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Tabs -->
              <div class="card-body pt-0 pb-0">
                <ul class="nav nav-tabs card-header-tabs">
                  <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#empTabEmployment">Employment</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#empTabContact">Contact</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#empTabGovIds">Gov. IDs</a>
                  </li>
                </ul>
              </div>

              <div class="tab-content">

                <!-- Tab: Employment -->
                <div class="tab-pane fade show active p-3" id="empTabEmployment">
                  <div class="d-flex flex-column gap-2">
                    <div class="row">
                      <div class="col-5 text-secondary small">Department</div>
                      <div class="col-7 fw-medium small text-end" id="empDepartment">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">Position</div>
                      <div class="col-7 fw-medium small text-end" id="empPosition">—</div>
                    </div>
                    <hr class="my-1">
                    <div class="row">
                      <div class="col-5 text-secondary small">Hire Date</div>
                      <div class="col-7 fw-medium small text-end" id="empDateHired">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">Regularized</div>
                      <div class="col-7 fw-medium small text-end" id="empDateRegularized">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">Birthday</div>
                      <div class="col-7 fw-medium small text-end" id="empBirthDate">—</div>
                    </div>
                  </div>
                </div>

                <!-- Tab: Contact -->
                <div class="tab-pane fade p-3" id="empTabContact">
                  <div class="d-flex flex-column gap-2">
                    <div class="row">
                      <div class="col-5 text-secondary small">Phone</div>
                      <div class="col-7 fw-medium small text-end" id="empPhone">—</div>
                    </div>
                    <hr class="my-1">
                    <div class="row">
                      <div class="col-5 text-secondary small">Address</div>
                      <div class="col-7 fw-medium small text-end" id="empAddress">—</div>
                    </div>
                    <hr class="my-1">
                    <div class="row">
                      <div class="col-5 text-secondary small">Emergency</div>
                      <div class="col-7 fw-medium small text-end" id="empEmergencyName">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">Emergency No.</div>
                      <div class="col-7 fw-medium small text-end" id="empEmergencyPhone">—</div>
                    </div>
                  </div>
                </div>

                <!-- Tab: Gov IDs -->
                <div class="tab-pane fade p-3" id="empTabGovIds">
                  <div class="d-flex flex-column gap-2">
                    <div class="row">
                      <div class="col-5 text-secondary small">TIN</div>
                      <div class="col-7 fw-medium small text-end" id="empTin">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">SSS</div>
                      <div class="col-7 fw-medium small text-end" id="empSss">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">PhilHealth</div>
                      <div class="col-7 fw-medium small text-end" id="empPhilhealth">—</div>
                    </div>
                    <div class="row">
                      <div class="col-5 text-secondary small">Pag-IBIG</div>
                      <div class="col-7 fw-medium small text-end" id="empPagibig">—</div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Footer actions -->
              <div class="card-footer d-flex gap-2">
                <button class="btn btn-secondary w-100"
                        id="btnOpenResign"
                        data-bs-toggle="modal"
                        data-bs-target="#modalResignEmployee"
                        data-id=""
                        data-is-resigned="">
                  Mark as Resigned
                </button>
                <button class="btn btn-primary w-100"
                        id="btnOpenEdit"
                        data-bs-toggle="modal"
                        data-bs-target="#modalEditEmployee"
                        data-id=""
                        data-first-name="" data-middle-name="" data-last-name="" data-suffix-name=""
                        data-department-id="" data-position-id=""
                        data-hire-date="" data-date-regularized="" data-birth-date=""
                        data-contact-no="" data-address1="" data-address2=""
                        data-sos-name="" data-sos-no=""
                        data-tin="" data-sss="" data-philhealth="" data-pagibig="">
                  Edit Details
                </button>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      // ── Detail card row click handler ──────────────────────
      (function () {
        const rows            = document.querySelectorAll('.employee-row');
        const selectedCard    = document.getElementById('selectedEmployee');
        const placeholderCard = document.getElementById('employeePlaceholder');
        const editBtn         = document.getElementById('btnOpenEdit');
        const resignBtn       = document.getElementById('btnOpenResign');

        function computeAge(dateStr) {
          if (!dateStr) return null;
          const birth = new Date(dateStr);
          const today = new Date();
          let age = today.getFullYear() - birth.getFullYear();
          const m = today.getMonth() - birth.getMonth();
          if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
          return age;
        }

        function formatDate(dateStr) {
          if (!dateStr) return '—';
          const d = new Date(dateStr);
          return d.toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
        }

        function getInitials(first, last) {
          return ((first[0] || '') + (last[0] || '')).toUpperCase();
        }

        rows.forEach(function (row) {
          row.addEventListener('click', function () {
            rows.forEach(r => r.classList.remove('table-active'));
            this.classList.add('table-active');

            placeholderCard.classList.add('d-none');
            selectedCard.classList.remove('d-none');

            const d = this.dataset;

            // ── Avatar ──
            document.getElementById('empAvatar').textContent = getInitials(d.firstName, d.lastName);

            // ── Header ──
            const fullName = `${d.lastName}, ${d.firstName}${d.middleName ? ' ' + d.middleName[0] + '.' : ''}`;
            document.getElementById('empName').textContent = fullName;
            document.getElementById('empId').textContent   = 'Employee No. ' + d.employeeId;

            // Status badge
            const badgeEl = document.getElementById('empStatusBadge');
            if (d.isResigned === '1') {
              badgeEl.innerHTML = '<span class="badge bg-red-lt">Resigned</span>';
            } else if (d.status === 'active') {
              badgeEl.innerHTML = '<span class="badge bg-success-lt">Active</span>';
            } else {
              badgeEl.innerHTML = '<span class="badge bg-secondary-lt">Inactive</span>';
            }

            // ── Employment tab ──
            document.getElementById('empDepartment').textContent    = d.department    || '—';
            document.getElementById('empPosition').textContent      = d.position      || '—';
            document.getElementById('empDateHired').textContent     = formatDate(d.hireDate);
            document.getElementById('empDateRegularized').textContent = formatDate(d.dateRegularized);

            const age = computeAge(d.birthDate);
            document.getElementById('empBirthDate').textContent = d.birthDate
              ? `${formatDate(d.birthDate)} (${age})`
              : '—';

            // ── Contact tab ──
            document.getElementById('empPhone').textContent = d.contactNo || '—';

            const addr = [d.address1, d.address2].filter(Boolean).join(', ');
            document.getElementById('empAddress').textContent       = addr || '—';
            document.getElementById('empEmergencyName').textContent  = d.sosName || '—';
            document.getElementById('empEmergencyPhone').textContent = d.sosNo   || '—';

            // ── Gov IDs tab ──
            document.getElementById('empTin').textContent       = d.tin       || '—';
            document.getElementById('empSss').textContent       = d.sss       || '—';
            document.getElementById('empPhilhealth').textContent = d.philhealth || '—';
            document.getElementById('empPagibig').textContent   = d.pagibig   || '—';

            // ── Edit button data ──
            Object.assign(editBtn.dataset, {
              id:              d.id,
              firstName:       d.firstName,
              middleName:      d.middleName,
              lastName:        d.lastName,
              suffixName:      d.suffixName,
              departmentId:    d.departmentId,
              positionId:      d.positionId,
              hireDate:        d.hireDate,
              dateRegularized: d.dateRegularized,
              birthDate:       d.birthDate,
              contactNo:       d.contactNo,
              address1:        d.address1,
              address2:        d.address2,
              sosName:         d.sosName,
              sosNo:           d.sosNo,
              tin:             d.tin,
              sss:             d.sss,
              philhealth:      d.philhealth,
              pagibig:         d.pagibig,
            });

            // ── Resign button ──
            resignBtn.dataset.id         = d.id;
            resignBtn.dataset.isResigned = d.isResigned;
            resignBtn.textContent        = d.isResigned === '1' ? 'Restore Employee' : 'Mark as Resigned';
            resignBtn.className          = d.isResigned === '1'
              ? 'btn btn-success w-100'
              : 'btn btn-secondary w-100';
          });
        });
      })();
    </script>

    <script>
      const csrfToken = '{{ csrf_token }}';
      const ALL_POSITIONS = {{ positions_json|safe }};

      // ── Guard syntax: Department ───────────────────────
      function initDeptPositionDropdown(deptSelectId, posSelectId) {
        const deptEl = document.getElementById(deptSelectId);
        const posEl  = document.getElementById(posSelectId);

        function populate(selectedDeptId, selectedPosId = '') {
          posEl.innerHTML = '';

          if (!selectedDeptId) {
            posEl.disabled = true;
            posEl.innerHTML = '<option value="">— Select department first —</option>';
            return;
          }

          const filtered = ALL_POSITIONS.filter(p => p.department_id == selectedDeptId);
          posEl.disabled = false;
          posEl.innerHTML = '<option value="">— Select position —</option>';
          filtered.forEach(p => {
            const opt = document.createElement('option');
            opt.value    = p.id;
            opt.text     = p.title;
            opt.selected = p.id == selectedPosId;
            posEl.appendChild(opt);
          });
        }

        deptEl.addEventListener('change', () => populate(deptEl.value));

        // Call this externally to set initial values when modal opens
        deptEl.populate = populate;
      }

      initDeptPositionDropdown('editEmpDepartmentId', 'editEmpPositionId');

      // ── Edit modal populate ────────────────────────────
      document.getElementById('modalEditEmployee').addEventListener('show.bs.modal', function (e) {
        const btn = e.relatedTarget;
        const d   = btn.dataset;

        document.getElementById('editEmpId').value                 = d.id;
        document.getElementById('editEmpFirstName').value          = d.firstName        || '';
        document.getElementById('editEmpMiddleName').value         = d.middleName       || '';
        document.getElementById('editEmpLastName').value           = d.lastName         || '';
        document.getElementById('editEmpSuffix').value             = d.suffixName       || '';
        //document.getElementById('editEmpDepartmentId').value       = d.departmentId     || '';
        //document.getElementById('editEmpPositionId').value         = d.positionId       || '';
        document.getElementById('editEmpHireDate').value           = d.hireDate         || '';
        document.getElementById('editEmpDateRegularized').value    = d.dateRegularized  || '';
        document.getElementById('editEmpBirthDate').value          = d.birthDate        || '';
        document.getElementById('editEmpContactNo').value          = d.contactNo        || '';
        document.getElementById('editEmpAddress1').value           = d.address1         || '';
        document.getElementById('editEmpAddress2').value           = d.address2         || '';
        document.getElementById('editEmpSosName').value            = d.sosName          || '';
        document.getElementById('editEmpSosNo').value              = d.sosNo            || '';
        document.getElementById('editEmpTin').value                = d.tin              || '';
        document.getElementById('editEmpSss').value                = d.sss              || '';
        document.getElementById('editEmpPhilhealth').value         = d.philhealth       || '';
        document.getElementById('editEmpPagibig').value            = d.pagibig          || '';

        const errEl = document.getElementById('editEmpErrors');

        const deptSel = document.getElementById('editEmpDepartmentId');
        const deptTS  = deptSel.tomselect;
        if (deptTS) deptTS.setValue(d.departmentId || '');
        deptSel.populate(d.departmentId, d.positionId);

        errEl.innerHTML = '';
        errEl.classList.add('d-none');
        document.querySelector('#modalEditEmployee a[href="#tabEmpBasic"]').click();
      });

      // ── Edit save ─────────────────────────────────────
      document.getElementById('btnEditEmployee').addEventListener('click', async () => {
        const id   = document.getElementById('editEmpId').value;
        const body = new FormData();

        body.append('first_name',         document.getElementById('editEmpFirstName').value);
        body.append('middle_name',        document.getElementById('editEmpMiddleName').value);
        body.append('last_name',          document.getElementById('editEmpLastName').value);
        body.append('suffix_name',        document.getElementById('editEmpSuffix').value);
        body.append('department_id',      document.getElementById('editEmpDepartmentId').value);
        body.append('position_id',        document.getElementById('editEmpPositionId').value);
        body.append('hire_date',          document.getElementById('editEmpHireDate').value);
        body.append('date_regularized',   document.getElementById('editEmpDateRegularized').value);
        body.append('birth_date',         document.getElementById('editEmpBirthDate').value);
        body.append('contact_no',         document.getElementById('editEmpContactNo').value);
        body.append('address_1',          document.getElementById('editEmpAddress1').value);
        body.append('address_2',          document.getElementById('editEmpAddress2').value);
        body.append('sos_contact_person', document.getElementById('editEmpSosName').value);
        body.append('sos_contact_no',     document.getElementById('editEmpSosNo').value);
        body.append('tin_no',             document.getElementById('editEmpTin').value);
        body.append('sss_no',             document.getElementById('editEmpSss').value);
        body.append('philhealth_no',      document.getElementById('editEmpPhilhealth').value);
        body.append('pagibig_no',         document.getElementById('editEmpPagibig').value);

        const url  = `{% url 'employee-update' 0 %}`.replace('0', id);
        const res  = await fetch(url, { method: 'POST', headers: { 'X-CSRFToken': csrfToken }, body });
        const data = await res.json();

        if (data.success) {
          alert(data.message);
          showToast(data.log_type, 'success');
          setTimeout(() => {
            location.reload();
          }, 2500);

        } else {
          const errEl = document.getElementById('editEmpErrors');
          errEl.innerHTML = Object.values(data.errors).map(e => `<div>${e}</div>`).join('');
          errEl.classList.remove('d-none');
          document.querySelector('#modalEditEmployee a[href="#tabEmpBasic"]').click();
          //alert('Please fix the following errors:\n\n' + Object.values(data.errors).join('\n'));
          showToast('Please fix the following errors:\n\n' + Object.values(data.errors).join('\n'), 'error');
        }
      });

      // ── Resign modal populate ─────────────────────────
      document.getElementById('modalResignEmployee').addEventListener('show.bs.modal', function (e) {
        const btn        = e.relatedTarget;
        const isResigned = btn.dataset.isResigned === '1';

        document.getElementById('resignEmpId').value         = btn.dataset.id;
        document.getElementById('resignEmpIsResigned').value = btn.dataset.isResigned;

        const title    = document.getElementById('resignModalTitle');
        const message  = document.getElementById('resignModalMessage');
        const btnLabel = document.getElementById('resignBtnLabel');
        const btnEl    = document.getElementById('btnResignEmployee');

        if (isResigned) {
          title.textContent    = 'Restore Employee';
          message.textContent  = 'This will restore the employee and set their status back to active.';
          btnLabel.textContent = 'Restore';
          btnEl.className      = 'btn btn-success';
        } else {
          title.textContent    = 'Mark as Resigned';
          message.textContent  = 'Are you sure? This will mark the employee as resigned and set them as inactive.';
          btnLabel.textContent = 'Mark as Resigned';
          btnEl.className      = 'btn btn-danger';
        }
      });

      // ── Resign save ───────────────────────────────────
      document.getElementById('btnResignEmployee').addEventListener('click', async () => {
        const id   = document.getElementById('resignEmpId').value;
        const url  = `{% url 'employee-resign' 0 %}`.replace('0', id);
        const res  = await fetch(url, { method: 'POST', headers: { 'X-CSRFToken': csrfToken } });
        const data = await res.json();
        if (data.success) {
          showToast(data.message, 'success');
          setTimeout(() => {
            location.reload();
          }, 2500);
        }
        else {
          showToast(data.message, 'danger');
        }
        
      });
    </script>

    <script>
      (function () {
        const searchInput  = document.getElementById('searchEmployeeInput');
        const statusFilter = document.getElementById('statusFilter');
        const pageCountEl  = document.getElementById('page-count');
        const paginationEl = document.getElementById('paginationEl');
        const rows         = Array.from(document.querySelectorAll('.employee-row'));
    
        let currentPage = 1;
        let pageSize    = 10;
    
        // ── Rows that pass search + status filter ─────────────
        function getFilteredRows() {
          const q      = searchInput.value.toLowerCase();
          const status = statusFilter.value;
          return rows.filter(row => {
            const matchSearch = !q      || row.textContent.toLowerCase().includes(q);
            const matchStatus = !status || row.dataset.status === status;
            return matchSearch && matchStatus;
          });
        }
    
        // ── Build page number list with ellipsis ──────────────
        function buildPageList(current, total) {
          const show   = new Set([1, total, current, current - 1, current + 1].filter(p => p >= 1 && p <= total));
          const sorted = [...show].sort((a, b) => a - b);
          const result = [];
          let prev = 0;
          for (const p of sorted) {
            if (p - prev > 1) result.push('...');
            result.push(p);
            prev = p;
          }
          return result;
        }
    
        // ── Main render ───────────────────────────────────────
        function render() {
          const filtered   = getFilteredRows();
          const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
    
          if (currentPage > totalPages) currentPage = totalPages;
    
          const start = (currentPage - 1) * pageSize;
          const end   = start + pageSize;
    
          rows.forEach(r => r.style.display = 'none');
          filtered.slice(start, end).forEach(r => r.style.display = '');
    
          // ── Render pagination items ───────────────────────
          paginationEl.innerHTML = '';
    
          buildPageList(currentPage, totalPages).forEach(item => {
            const li = document.createElement('li');
            if (item === '...') {
              li.className = 'page-item disabled';
              li.innerHTML = `<a class="page-link cursor-pointer">...</a>`;
            } else {
              li.className = `page-item${item === currentPage ? ' active' : ''}`;
              li.innerHTML = `<a class="page-link cursor-pointer" data-i="${item}" data-page="${pageSize}">${item}</a>`;
              li.querySelector('a').addEventListener('click', () => { currentPage = item; render(); });
            }
            paginationEl.appendChild(li);
          });
        }
    
        // ── setPageListItems — called by the dropdown onclick ─
        window.setPageListItems = function (event) {
          pageSize    = parseInt(event.target.dataset.value);
          currentPage = 1;
          pageCountEl.textContent = pageSize;
          render();
        };
    
        // ── Search + filter reset to page 1 ──────────────────
        searchInput.addEventListener('input',   () => { currentPage = 1; render(); });
        statusFilter.addEventListener('change', () => { currentPage = 1; render(); });
    
        // ── Initial render ────────────────────────────────────
        statusFilter.value = 'active';
        render();
      })();
    </script>
    {% if request.user.role.name == 'Administrator' %}
    <div class="modal modal-blur fade" id="modalBatchDeactivate" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Set Employees to Inactive</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p class="text-secondary">This will set the following employees to inactive and unassign their schedule going forward. Their past attendance records will not be affected.</p>
            <ul id="batchDeactivateList" class="mb-0"></ul>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-ghost-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger" id="btnConfirmBatchDeactivate">
              Set Inactive
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      (function () {
        const selectAll   = document.getElementById('selectAllEmployees');
        const batchBtn    = document.getElementById('btnBatchDeactivate');
        const countEl     = document.getElementById('batchSelectedCount');
        const listEl      = document.getElementById('batchDeactivateList');
        const confirmBtn  = document.getElementById('btnConfirmBatchDeactivate');

        function getChecked() {
          return Array.from(document.querySelectorAll('.emp-select-checkbox:checked'));
        }

        const actionLabelEl = document.getElementById('batchActionLabel');

        function refreshBatchButton() {
          const checked = getChecked();
          countEl.textContent = checked.length;
          batchBtn.classList.toggle('d-none', checked.length === 0);

          if (!checked.length) return;
          const action = getBatchAction();
          if (action === 'mixed') {
            // actionLabelEl.textContent = 'Select only Active or only Inactive';
            showToast('Select only Active or Inactive Status', 'info')
            batchBtn.className = 'btn btn-outline-secondary disabled';
          } else if (action === 'reactivate') {
            actionLabelEl.textContent = 'Restore to Active';
            batchBtn.className = 'btn btn-outline-success';
          } else {
            actionLabelEl.textContent = 'Set Inactive';
            batchBtn.className = 'btn btn-outline-danger';
          }
        }

        document.addEventListener('change', function (e) {
          if (e.target.classList.contains('emp-select-checkbox')) refreshBatchButton();
        });

        function refreshSelectAllState() {
          const status = statusFilter.value;
          const allowed = (status === 'active' || status === 'inactive');
          selectAll.disabled = !allowed;
          if (!allowed) selectAll.checked = false;
          selectAll.title = allowed ? '' : 'Filter by Active or Inactive to use Select All';
        }

        selectAll.addEventListener('change', function () {
          // Hard guard: bail out entirely if filter doesn't permit a uniform batch
          const status = statusFilter.value;
          if (status !== 'active' && status !== 'inactive') {
            selectAll.checked = false;
            return;
          }
          document.querySelectorAll('.emp-select-checkbox').forEach(cb => {
            const row = cb.closest('tr');
            if (row.style.display !== 'none' && !cb.disabled) cb.checked = selectAll.checked;
          });
          refreshBatchButton();
        });

        statusFilter.addEventListener('change', refreshSelectAllState);
        refreshSelectAllState(); // initial state on page load

        document.getElementById('modalBatchDeactivate').addEventListener('show.bs.modal', function () {
          const checked = getChecked();
          const action  = getBatchAction();
          listEl.innerHTML = checked.map(cb => `<li>${cb.dataset.name}</li>`).join('');

          const modalTitle   = document.querySelector('#modalBatchDeactivate .modal-title');
          const modalMessage = document.querySelector('#modalBatchDeactivate .modal-body p');
          const modalConfirm = document.getElementById('btnConfirmBatchDeactivate');

          if (action === 'reactivate') {
            modalTitle.textContent   = 'Restore Employees to Active';
            modalMessage.textContent = 'This will set the following employees back to active. You will need to assign a schedule separately.';
            modalConfirm.className   = 'btn btn-success';
            modalConfirm.innerHTML   = 'Restore to Active';
          } else {
            modalTitle.textContent   = 'Set Employees to Inactive';
            modalMessage.textContent = 'This will set the following employees to inactive and unassign their schedule going forward. Their past attendance records will not be affected.';
            modalConfirm.className   = 'btn btn-danger';
            modalConfirm.innerHTML   = 'Set Inactive';
          }
        });

       function getBatchAction() {
          const checked  = getChecked();
          const statuses = new Set(checked.map(cb => cb.dataset.active));
          if (statuses.size > 1) return 'mixed';
          if (statuses.has('0')) return 'reactivate';
          return 'deactivate';
        }

        confirmBtn.addEventListener('click', async function () {
          const ids    = getChecked().map(cb => cb.value);
          const action = getBatchAction();
          if (!ids.length || action === 'mixed') {
            showToast('Please select employees with the same status (all Active or all Inactive) before proceeding.', 'info');
            return;
          }

          confirmBtn.disabled = true;
          confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing…';

          const res = await fetch("{% url 'employee-batch-deactivate' %}", {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
            body: JSON.stringify({ employee_ids: ids, action: action }),
          });
          const data = await res.json();

          if (data.success) {
            showToast(data.message, 'success');
            setTimeout(() => {
              location.reload();
            }, 2500);
          } else {
            showToast(data.message, 'danger');
            confirmBtn.disabled = false;
            confirmBtn.innerHTML = action === 'reactivate'
              ? 'Restore to Active'
              : 'Set Inactive';
          }
        });
      })();
    </script>
    {% endif %}
    <script src="{% static 'js/tours/employees.js' %}"></script>
{% endblock %}