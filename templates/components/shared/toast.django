{% load static %}
  {% comment %} 
  <div class="position-fixed bottom-0 end-0 p-3 d-flex flex-column gap-2" style="z-index: 1089;">
    <button onclick="showToast('Record saved successfully.', 'success')" class="btn btn-success btn-sm">Toast Success</button>
    <button onclick="showToast('Something went wrong.', 'danger')"       class="btn btn-danger btn-sm">Toast Danger</button>
    <button onclick="showToast('Please review this entry.', 'warning')"  class="btn btn-warning btn-sm">Toast Warning</button>
    <button onclick="showToast('Flagged for approval.', 'info')"         class="btn btn-info btn-sm">Toast Info</button>
  </div>
  {% endcomment %}
  <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3 mt-4" style="z-index: 9999;">
    <div id="appToast" class="toast border-0 shadow-sm rounded-3 overflow-hidden" role="alert" aria-live="assertive" aria-atomic="true" style="min-width: 300px;">
      <div id="appToastInner" class="d-flex align-items-center gap-3 px-3 py-3 rounded-3 border border-2">
        <span id="appToastIcon" class="d-flex align-items-center flex-shrink-0"></span>
        <span id="appToastMessage" class="flex-fill fw-bold text-center medium"></span>
        <button type="button" class="btn-close ms-auto opacity-50" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>

  <script>
    function showToast(message, type = 'success', duration = 2500) {
      const typeMap = {
        success: {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8.56 3.69a9 9 0 0 0 -2.92 1.95"/><path d="M3.69 8.56a9 9 0 0 0 -.69 3.44"/><path d="M3.69 15.44a9 9 0 0 0 1.95 2.92"/><path d="M8.56 20.31a9 9 0 0 0 3.44 .69"/><path d="M15.44 20.31a9 9 0 0 0 2.92 -1.95"/><path d="M20.31 15.44a9 9 0 0 0 .69 -3.44"/><path d="M20.31 8.56a9 9 0 0 0 -1.95 -2.92"/><path d="M15.44 3.69a9 9 0 0 0 -3.44 -.69"/><path d="M9 12l2 2l4 -4"/></svg>`,
          textClass:   'text-success',
          bgClass:     'bg-success-lt',
          borderClass: 'border-success',
        },
        danger: {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/><path d="M10 10l4 4m0 -4l-4 4"/></svg>`,
          textClass:   'text-danger',
          bgClass:     'bg-danger-lt',
          borderClass: 'border-danger',
        },
        warning: {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 9v4"/><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0"/><path d="M12 16h.01"/></svg>`,
          textClass:   'text-warning',
          bgClass:     'bg-warning-lt',
          borderClass: 'border-warning',
        },
        info: {
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M12 9h.01"/><path d="M11 12h1v4h1"/></svg>`,
          textClass:   'text-info',
          bgClass:     'bg-info-lt',
          borderClass: 'border-info',
        },
      };

      const cfg   = typeMap[type] ?? typeMap.success;
      const toast = document.getElementById('appToast');
      const inner = document.getElementById('appToastInner');
      const icon  = document.getElementById('appToastIcon');
      const body  = document.getElementById('appToastMessage');

      // clear previous type classes
      inner.classList.remove('bg-success-lt', 'bg-danger-lt', 'bg-warning-lt', 'bg-info-lt',
                             'border-success', 'border-danger', 'border-warning', 'border-info');
      icon.classList.remove('text-success', 'text-danger', 'text-warning', 'text-info');
      body.classList.remove('text-success', 'text-danger', 'text-warning', 'text-info');

      inner.classList.add(cfg.bgClass, cfg.borderClass);
      icon.classList.add(cfg.textClass);
      body.classList.add(cfg.textClass);
      icon.innerHTML   = cfg.icon;
      body.textContent = message;

      tabler.Toast.getOrCreateInstance(toast, { delay: duration }).show();
    }
  </script>