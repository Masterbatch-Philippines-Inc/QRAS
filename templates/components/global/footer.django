{% load static %}
<footer class="footer footer-transparent d-print-none">
  <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-center gap-1 text-center text-md-start">
    <div class="text-muted">© 2026 QR Attendance | <a href="#" role="button" id="themeToggle">Try Dark Mode</a> {% if request.resolver_match.url_name == 'login' %}| <a href="{% url 'scanner' %}" role="button">Try QR Scanner</a>{% endif %}</div>
    <div class="text-primary fw-bold" id="datetimeFooter"></div>
    <div class="text-muted">Version 2.0.1</div>
  </div>
</footer>